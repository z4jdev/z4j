/static/*
  Cache-Control: public, max-age=31536000, immutable

/demo-data/*
  Cache-Control: public, max-age=300

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-EqEyotyKLzCU0V8OtlrxP0ccw75+qBdWsjEd2RgSSnM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
