# syntax=docker.io/docker/dockerfile:1.20.0@sha256:26147acbda4f14c5add9946e2fd2ed543fc402884fd75146bd342a7f6271dc1d
#
# Dashboard dev container - Vite + HMR.
#
# Used only by docker-compose.dev.yml. Production builds the
# dashboard inside the unified brain image (see
# packages/z4j-brain/backend/Dockerfile stage 1).
#
# Build context: monorepo root.

FROM node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03

ENV CI=true \
    PNPM_HOME=/root/.local/share/pnpm \
    PATH=/root/.local/share/pnpm:$PATH \
    HOST=0.0.0.0

RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

WORKDIR /dashboard

# Cache install layer.
COPY packages/z4j/dashboard/package.json packages/z4j/dashboard/pnpm-lock.yaml* packages/z4j/dashboard/pnpm-workspace.yaml packages/z4j/dashboard/.npmrc ./

# Audit H22: dev-only image; tolerate a missing lockfile (fresh
# clone) but still surface other failures. No double-fallback.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install

# Copy initial source - at runtime this is overlaid by a bind mount
# from the host so edits hot-reload.
COPY packages/z4j/dashboard/ ./

# Drop root for parity with the production brain image. The
# official node image ships a non-root ``node`` user (UID 1000).
# We chown the workdir so the bind-mount overlay doesn't end up
# with root-owned files on the host.
RUN chown -R node:node /dashboard
USER node

EXPOSE 5173

# --config.verify-deps-before-run=false: at runtime corepack resolves the
# node user's pnpm to its latest known release (the root-user `corepack
# prepare pnpm@11.24.0` above does not apply to USER node), and pnpm 11's
# pre-run deps reconcile aborts `pnpm dev` against the image-installed
# node_modules volume. Skipping only that check keeps HMR working on any
# pnpm; it does NOT enable dependency install scripts (same posture as
# scripts/build-demo.mjs and the Makefile dash-bundle target).
CMD ["pnpm", "--config.verify-deps-before-run=false", "dev", "--host", "0.0.0.0", "--port", "5173"]
