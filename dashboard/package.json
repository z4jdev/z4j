{
  "name": "@z4j/dashboard",
  "packageManager": "pnpm@12.3.4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "z4j brain dashboard - TanStack Router + React 19 + shadcn/ui",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "generate:routes": "node scripts/generate-routes.mjs",
    "generate:routes:fresh": "node scripts/generate-routes.mjs --fresh",
    "dev": "node scripts/generate-routes.mjs && vite",
    "build": "node scripts/gen-third-party-notices.mjs --check && node scripts/generate-routes.mjs --fresh && vite build && tsc -b --noEmit && node scripts/check-no-maps.mjs",
    "build:demo": "node scripts/gen-third-party-notices.mjs --check && node scripts/generate-routes.mjs --fresh && node scripts/build-demo.mjs",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo --port 4173",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"!src/routeTree.gen.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:fetch": "node scripts/fetch-openapi-snapshot.mjs",
    "openapi:gen": "openapi-typescript src/lib/openapi-snapshot.json -o src/lib/openapi-types.gen.ts --immutable",
    "openapi:check": "openapi-typescript src/lib/openapi-snapshot.json -o src/lib/.openapi-types.gen.check.ts --immutable && node scripts/check-openapi-generated.mjs && pnpm typecheck",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "rolldown": "1.2.15",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "12.3.4"
  },
  "//playwright": [
    "@playwright/test is pinned EXACT and must equal the image tag in",
    ".github/workflows/e2e.yml. The runner and the browser build ship",
    "together: a mismatched runner asks the pinned image for a Chromium",
    "revision it does not contain, and the spine dies before a single test",
    "runs. The committed visual baselines are also coupled to that image's",
    "font set, so the image cannot be bumped without re-reviewing them.",
    "tests/release/test_e2e_workflow.py asserts the two match."
  ]
}
