# /etc/z4j/brain.env - environment for z4j-brain.service.
#
# Owner root, mode 0600: systemd reads it, the z4j user never sees it.
# Single-quote JSON values so systemd hands the brain the brackets and the
# inner double quotes unchanged.

# ----- posture (required) -----
Z4J_ENVIRONMENT=production
# Externally reachable https origin; the reverse proxy in front of the
# brain terminates TLS and forwards X-Forwarded-For.
Z4J_PUBLIC_URL=https://z4j.example.com
Z4J_ALLOWED_HOSTS='["z4j.example.com"]'
# The brain listens on loopback for the local reverse proxy.
Z4J_BIND_HOST=127.0.0.1
Z4J_BIND_PORT=7700
Z4J_TRUSTED_PROXIES='["127.0.0.1/32"]'

# ----- application secrets -----
# Required on PostgreSQL. On the default SQLite the brain mints them on
# first boot into /var/lib/z4j/secret.env; leaving them empty is fine.
# Generate each with: openssl rand -hex 48
Z4J_SECRET=
Z4J_SESSION_SECRET=
Z4J_AUDIT_CHAIN_SECRET=

# ----- database -----
# Unset: bundled SQLite at /var/lib/z4j/z4j.db. For PostgreSQL the URL
# must carry sslmode=require, verify-ca or verify-full.
# Z4J_DATABASE_URL=postgresql+asyncpg://z4j:PASSWORD@127.0.0.1:5432/z4j?sslmode=require

# ----- logging -----
Z4J_LOG_JSON=true
Z4J_LOG_LEVEL=INFO

# ----- scheduler -----
# Single-host option: run the scheduler as a supervised subprocess with
# auto-minted loopback PKI.
# Z4J_EMBEDDED_SCHEDULER=true
#
# Standalone option: expose the mTLS gRPC listener for z4j-scheduler.service.
# The server leaf, its key and the CA that signs the scheduler client
# certificate live under /etc/z4j/tls, readable by the z4j user only.
# Z4J_SCHEDULER_GRPC_ENABLED=true
# Z4J_SCHEDULER_GRPC_BIND_HOST=127.0.0.1
# Z4J_SCHEDULER_GRPC_BIND_PORT=7701
# Z4J_SCHEDULER_GRPC_TLS_CERT=/etc/z4j/tls/brain.crt
# Z4J_SCHEDULER_GRPC_TLS_KEY=/etc/z4j/tls/brain.key
# Z4J_SCHEDULER_GRPC_TLS_CA=/etc/z4j/tls/ca.crt
# Z4J_SCHEDULER_GRPC_ALLOWED_CNS='["scheduler-1"]'
