# /etc/z4j/scheduler.env - environment for z4j-scheduler.service.
#
# Owner root, mode 0600: systemd reads it, the z4j user never sees it.

# ----- brain wiring (required) -----
# host:port of the brain's mTLS gRPC listener and the scheme-qualified REST
# origin. On the same host as z4j-brain.service these are loopback.
Z4J_SCHEDULER_BRAIN_GRPC_URL=127.0.0.1:7701
Z4J_SCHEDULER_BRAIN_REST_URL=http://127.0.0.1:7700

# ----- mTLS client material (required) -----
# Minted against the CA the brain trusts, e.g.
#   z4j mint-scheduler-cert --name scheduler-1 --ca-cert ca.crt --ca-key ca.key --out-dir /etc/z4j/tls
# The CN (scheduler-1) must be listed in the brain's Z4J_SCHEDULER_GRPC_ALLOWED_CNS.
Z4J_SCHEDULER_TLS_CERT=/etc/z4j/tls/scheduler-1.crt
Z4J_SCHEDULER_TLS_KEY=/etc/z4j/tls/scheduler-1.key
Z4J_SCHEDULER_TLS_CA=/etc/z4j/tls/ca.crt
Z4J_SCHEDULER_INSTANCE_ID=scheduler-1

# ----- leader election -----
# One scheduler on one host: "single" (always leader) needs no database.
# For failover across hosts use postgres_per_project and a plain libpq
# URL for the same database the brain uses (postgresql://, never the
# brain's postgresql+asyncpg:// spelling).
Z4J_SCHEDULER_LEADER_BACKEND=single
# Z4J_SCHEDULER_LEADER_BACKEND=postgres_per_project
# Z4J_SCHEDULER_LEADER_PG_DSN=postgresql://z4j:PASSWORD@127.0.0.1:5432/z4j?sslmode=require

# ----- operational HTTP (health, ready, info, metrics) -----
# Loopback bind: /metrics needs no bearer token when nothing but the host
# can reach it. Bind a non-loopback address only with a token set.
Z4J_SCHEDULER_BIND_HOST=127.0.0.1
Z4J_SCHEDULER_BIND_PORT=7800
Z4J_SCHEDULER_METRICS_ENABLED=true
# Z4J_SCHEDULER_METRICS_AUTH_TOKEN=

# ----- logging -----
Z4J_SCHEDULER_LOG_JSON=true
Z4J_SCHEDULER_LOG_LEVEL=INFO
